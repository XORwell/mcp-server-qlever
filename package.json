{
  "name": "mcp-server-qlever",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server for QLever SPARQL engine — query knowledge graphs from Claude Code and other MCP clients",
  "author": "XORwell",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XORwell/mcp-server-qlever.git"
  },
  "bugs": {
    "url": "https://github.com/XORwell/mcp-server-qlever/issues"
  },
  "homepage": "https://github.com/XORwell/mcp-server-qlever#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "qlever",
    "sparql",
    "rdf",
    "knowledge-graph",
    "wikidata",
    "linked-data",
    "claude",
    "claude-code"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-server-qlever": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:ci": "docker compose -f docker-compose.test.yml up -d --wait && vitest run; docker compose -f docker-compose.test.yml down -v",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
